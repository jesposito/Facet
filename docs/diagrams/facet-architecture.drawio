        <mxCell id="C1" value="Facet Container — Docker (single public port 8080)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="440" height="470" as="geometry"/></mxCell>
        <mxCell id="caddy" value="Caddy reverse proxy  :8080&#10;routes /api/* and /*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="C1"><mxGeometry x="20" y="45" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="svelte" value="SvelteKit (Node)  :3000&#10;Public pages + Admin UI (SSR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="C1"><mxGeometry x="20" y="115" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="go" value="Go + PocketBase  :8090&#10;REST API + 25+ hook modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="C1"><mxGeometry x="220" y="115" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="svc" value="Services&#10;Crypto (AES-256-GCM) · AI&#10;GitHub · Share · Purchase&#10;Webhooks · RateLimit · Backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="C1"><mxGeometry x="220" y="205" width="200" height="90" as="geometry"/></mxCell>
