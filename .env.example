# Facet Environment Configuration
# Copy to .env and configure

# ============================================
# ENCRYPTION (Auto-generated if not set)
# ============================================

# Encryption key for API tokens
# If not set, one is auto-generated on first run and saved to /data/.encryption_key
# ENCRYPTION_KEY=

# ============================================
# AI PROVIDERS (Optional - enables AI content improvement)
# ============================================
# Set one of these to enable AI-powered content generation/improvement.
# If set, the provider will be auto-configured on startup.

# Anthropic Claude (recommended)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ============================================
# AUTH (Optional - enables OAuth login)
# ============================================
# Configure OAuth providers without opening the PocketBase UI.
# Redirect URIs should point to: <APP_URL>/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend ↔ PocketBase (set when running frontend on a different host/port)
# VITE_POCKETBASE_URL=http://localhost:8090

# ============================================
# NETWORK
# ============================================

# Port to expose (single port for everything)
PORT=8080

# Your public URL (used for OAuth callbacks, email links and link generation)
# - Direct access: http://localhost:8080
# - Behind reverse proxy: https://facet.yourdomain.com
# Saved to PocketBase settings on every start, with or without OAuth/SMTP.
# Leaving it empty keeps the URL already saved in PocketBase settings. Newer
# enrollment emails need a configured URL and are never built from the
# request's host, so set this before inviting people.
APP_URL=http://localhost:8080

# Optional: different public URL for robots.txt and sitemap.xml only
# PUBLIC_APP_URL=https://facet.yourdomain.com

# Optional: name shown in PocketBase auth emails (default: Facet)
# APP_NAME=Facet

# Trust the client address Caddy supplies over loopback in the bundled container.
# Default: true, including direct access to the container's Caddy listener.
# External reverse proxies must also be listed in TRUSTED_PROXIES below.
TRUST_PROXY=true

# Space-separated CIDRs of reverse proxies allowed to supply client addresses.
# Configure this when using a tunnel or reverse proxy; all other peers supply
# their own connection address. Never use 0.0.0.0/0 or ::/0.
# TRUSTED_PROXIES=172.18.0.0/16

# ============================================
# SECURITY
# ============================================

# Comma-separated list of emails allowed to log in as admin
# Leave empty to allow any authenticated user
ADMIN_EMAILS=

# Enable PocketBase admin UI at /_/ (default: disabled for security)
ADMIN_ENABLED=false

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================
# Your own SMTP server sends all email: newsletters and their sign-up
# confirmations, testimonial notifications and verification, and admin tests.
# There is no other mail transport. Newsletters also need SMTP_SENDER_ADDRESS
# and APP_URL. SPF, DKIM and DMARC for the sender domain are yours to set up.
# These can also be configured in the admin UI at /admin/settings/site.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_TLS=false
# Use SMTP_TLS=true for implicit TLS (usually port 465). Port 587 uses STARTTLS.
# SMTP_AUTH_METHOD=PLAIN

# Sender identity for outgoing emails
# SMTP_SENDER_NAME=Facet
# SMTP_SENDER_ADDRESS=noreply@yourdomain.com

# ============================================
# PAYMENTS (Optional)
# ============================================
# Stripe keys saved in the admin UI take priority over these.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================
# BACKUPS (Optional)
# ============================================
# Automatic daily backups go to DATA_PATH/backups.
# Hour of day in UTC (0-23), and how many automatic backups to keep.
# BACKUP_HOUR=2
# BACKUP_MAX_COUNT=10

# ============================================
# TUNING (Optional)
# ============================================
# Pause between newsletter messages in milliseconds (default: 1000). One
# campaign sends at a time; raise this to stay under your SMTP provider's limits.
# NEWSLETTER_SEND_INTERVAL_MS=1000
# NEWSLETTER_MAX_CONCURRENT_SENDS is legacy and no longer allows parallel campaigns.
# Go duration before a repeat view from the same visitor counts again (default: 30m)
# VIEW_DEDUP_WINDOW=30m
# Set to 1 to skip the startup content recovery pass
# CONTENT_RECOVERY_DISABLED=

# ============================================
# DATA
# ============================================

# Where to store database and config (small, critical - back this up!)
DATA_PATH=./data

# Where to store uploads (can be large - put where you have space)
UPLOADS_PATH=./uploads

# User and group IDs that own files in DATA_PATH and UPLOADS_PATH
# PUID=1000
# PGID=1000

# Seed data for development
# - "dev": Full development profile (Jedidiah Esposito with experience/projects)
# - "minimal" or unset: Admin account with a random password shown in the backend startup log
#
# Production default (unset or minimal): Creates admin@example.com account
# This ensures first-time users can log in and set up their profile
# SEED_DATA=dev

# ============================================
# EXAMPLE CONFIGURATIONS
# ============================================

# --- Direct access to the container's Caddy listener ---
# PORT=8080
# APP_URL=http://localhost:8080
# TRUST_PROXY=true

# --- Cloudflare Tunnel ---
# PORT=8080
# APP_URL=https://facet.yourdomain.com
# TRUST_PROXY=true

# Space-separated CIDRs of reverse proxies allowed to supply client addresses.
# Configure this when using a tunnel or reverse proxy; all other peers supply
# their own connection address. Never use 0.0.0.0/0 or ::/0.
# TRUSTED_PROXIES=172.18.0.0/16
# Point tunnel to: http://container-ip:8080

# --- Nginx Proxy Manager ---
# PORT=8080
# APP_URL=https://facet.yourdomain.com
# TRUST_PROXY=true

# Space-separated CIDRs of reverse proxies allowed to supply client addresses.
# Configure this when using a tunnel or reverse proxy; all other peers supply
# their own connection address. Never use 0.0.0.0/0 or ::/0.
# TRUSTED_PROXIES=172.18.0.0/16
# Forward to: http://container-ip:8080

# --- Traefik ---
# PORT=8080
# APP_URL=https://facet.yourdomain.com
# TRUST_PROXY=true

# Space-separated CIDRs of reverse proxies allowed to supply client addresses.
# Configure this when using a tunnel or reverse proxy; all other peers supply
# their own connection address. Never use 0.0.0.0/0 or ::/0.
# TRUSTED_PROXIES=172.18.0.0/16
# Add labels in docker-compose.yml for routing

# ============================================
# UNRAID CONFIGURATIONS
# ============================================

# --- Unraid: Local Network Access Only ---
# PORT=8080
# DATA_PATH=/mnt/user/appdata/facet
# UPLOADS_PATH=/mnt/user/appdata/facet/uploads
# APP_URL=http://tower.local:8080

# --- Unraid: With Cloudflare Tunnel / NPM (Recommended) ---
# PORT=8080
# DATA_PATH=/mnt/user/appdata/facet
# UPLOADS_PATH=/mnt/user/media/facet
# APP_URL=https://facet.yourdomain.com
