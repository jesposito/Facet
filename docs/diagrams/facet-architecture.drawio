<mxfile host="facet-docs" version="24.0.0">
  <diagram id="facet-arch" name="Facet — Single-Tenant Architecture">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Facet — Single-Tenant Self-Hosted Architecture" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="520" height="30" as="geometry"/></mxCell>

        <mxCell id="visitor" value="Visitor&#10;(public profile)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="140" height="50" as="geometry"/></mxCell>
