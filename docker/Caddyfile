# Facet Caddy Configuration
# Single entry point that routes to internal services
# Designed for use behind reverse proxies (Cloudflare Tunnel, nginx, etc.)

# Facet's public links carry bearer tokens: whoever holds one can open the
# restricted page, file or purchase behind it. These filters keep the method,
# status, host and the rest of the URL for diagnosis and drop only the tokens.
# They change what's logged, never what's forwarded.
#
# A field takes one filter, so every URL rule lives in one multi_regexp; Caddy
# rejects or silently replaces a query filter on the same field. The rules run
# in order on the raw request URI, before any decoding:
#   1. A path with an encoded ASCII byte, an empty segment or a dot segment can
#      still route to a token page, so the whole path is dropped.
#   2. Token routes keep their prefix and lose everything up to the query.
#   3. Token query values are dropped, as is any value whose parameter name is
#      percent-encoded.
# A new token route belongs in rule 2 and a new token parameter in rule 3, with
# a case in docker/caddy/log_privacy_test.go.
#
# Caddy already logs Authorization, Cookie and Set-Cookie as REDACTED. Referer
# and Location can repeat a token URL, and the X- headers below carry tokens.
(token_safe_log_format) {
    format filter {
        wrap {args[0]}
        fields {
            request>uri multi_regexp {
                regexp `^[^?]*(?:%[0-7]|//|/\.\.?/)[^?]*` `[REDACTED_PATH]`
                regexp `(?i)(/(?:s|testimonial|unsubscribe|api/downloads|api/content/access|api/public/newsletter/(?:confirm|open|click)|api/testimonials/request|api/testimonials/verify/email)/)[^?]*` `$1[REDACTED]`
                regexp `(?i)([?&;](?:t|token|code|state|session_id|[^=&;]*%[^=&;]*)=)[^&]*` `$1[REDACTED]`
            }
            request>headers>Referer delete
            request>headers>X-Share-Token delete
            request>headers>X-Share-Visit delete
            request>headers>X-Password-Token delete
            resp_headers>Location delete
            resp_headers>X-Share-Visit delete
            resp_headers>X-Share-Token delete
            resp_headers>X-Password-Token delete
        }
    }
}

{
    servers {
        # Client addresses. Caddy only believes X-Forwarded-For from the
        # proxies listed in TRUSTED_PROXIES (space-separated CIDRs, such as
        # your Cloudflare Tunnel or Nginx Proxy Manager container's network).
        # It reads the header right to left and stops at the first address it
        # doesn't trust, so a visitor can't prepend a fake one. With the
        # default, only loopback is trusted, which in practice means every
        # connection is taken at face value.
        trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For
    }

    # Failed requests go to the default logger with the same URI and headers.
    log {
        import token_safe_log_format json
    }
}

# The backend keys rate limits on X-Forwarded-For when the request comes from
# loopback, so Caddy replaces it with the one client address it settled on.
(backend) {
    reverse_proxy localhost:8090 {
        header_up X-Forwarded-For {client_ip}
    }
}

# The frontend reads the client address from this header (ADDRESS_HEADER in the
# Dockerfile), so Caddy overwrites whatever the caller sent.
(frontend) {
    reverse_proxy localhost:3000 {
        header_up X-Facet-Client-IP {client_ip}
    }
}

:8080 {
    # X-Internal marks the frontend's own server-side calls, which go straight
    # to :8090 and never through Caddy. Nothing arriving here may carry it.
    request_header -X-Internal

    # =========================================================================
    # PHASE 5A: Minimal safe security headers
    # See docs/SECURITY.md for rationale and Phase 5B options
    # Ref: https://owasp.org/www-project-secure-headers/
    # =========================================================================
    header {
        # Prevent MIME type sniffing (universal, no risk)
        X-Content-Type-Options "nosniff"

        # Prevent cross-origin clickjacking, but allow SAMEORIGIN framing so the
        # admin live-preview pane can embed this instance's own public site.
        # (DENY blocked even same-origin frames, breaking the preview.)
        X-Frame-Options "SAMEORIGIN"

        # Preserve stricter route policies on token-bearing pages.
        ?Referrer-Policy "strict-origin-when-cross-origin"

        # Disable browser features not used by Facet
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

        # HSTS - safe because all traffic goes through Cloudflare (TLS-terminated at edge)
        Strict-Transport-Security "max-age=31536000; includeSubDomains"

        # Remove server identification
        -Server

        # Content Security Policy (enforcing)
        # Restricts script/style/frame sources to mitigate XSS.
        # 'unsafe-inline' kept for scripts/styles due to Svelte's inline injection pattern.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://w.soundcloud.com https://open.spotify.com https://codepen.io https://www.figma.com; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

        # INTENTIONALLY OMITTED:
        # - X-XSS-Protection: Deprecated since 2023, can cause vulnerabilities
        # - COOP/COEP/CORP: Phase 5B - requires testing with frontend
        # - CSP nonce-based: Would allow removing 'unsafe-inline'; requires SSR nonce injection
    }

    # Request body size limit
    request_body {
        max_size 25MB
    }

    # Uploaded files (images, etc.) — cacheable, served by PocketBase
    # The backend sets Cache-Control per file: private, no-store for
    # protected (paid) files. The ? only fills it in when the backend didn't.
    handle /api/files/* {
        header ?Cache-Control "public, max-age=86400"
        import backend
    }

    # API and PocketBase routes go to backend (no caching)
    handle /api/* {
        header Cache-Control "no-store, no-cache"
        import backend
    }

    # Static feeds served by backend
    handle /rss.xml {
        import backend
    }

    handle /talks.ics {
        import backend
    }

    # Version files - no caching to ensure updates are seen immediately
    handle /CHANGELOG.md {
        header Cache-Control "no-cache, no-store, must-revalidate"
        import frontend
    }

    handle /LATEST_VERSION {
        header Cache-Control "no-cache, no-store, must-revalidate"
        import frontend
    }

    handle /_/* {
        # PocketBase admin - only allow if ADMIN_ENABLED=true
        @admin_disabled expression `{env.ADMIN_ENABLED} != "true"`
        respond @admin_disabled "Not Found" 404

        import backend
    }

    # SvelteKit immutable assets (content-hashed filenames, safe to cache forever)
    handle /_app/immutable/* {
        header Cache-Control "public, max-age=31536000, immutable"
        import frontend
    }

    # Everything else goes to SvelteKit frontend
    handle {
        import frontend
    }

    # Logging
    log {
        output stdout
        import token_safe_log_format console
    }
}
